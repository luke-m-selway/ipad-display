#!/bin/bash
# Read-only deployment/runtime checks for the validated Intel Ventura target.

set -u

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
INSTALL_ROOT="${HOME}/.local/lib/ipad-display"
NODE_VERSION="v23.11.1"
NODE_DIST="node-${NODE_VERSION}-darwin-x64"
NODE_BIN="$INSTALL_ROOT/runtime/$NODE_DIST/bin"
INPUT_HELPER="$INSTALL_ROOT/ipad-input-helper"
INPUT_HELPER_SOURCE="$REPO_DIR/scripts/ipad-input-helper.m"
HOST_ENTRY="$REPO_DIR/out/main/ipad-host.js"
VIEWER_ENTRY="$REPO_DIR/out/ipad-viewer/index.html"
FIXED_IP="192.168.2.1"
FIXED_PORT="3131"
failures=0
warnings=0

pass() { printf 'PASS  %s\n' "$*"; }
info() { printf 'INFO  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; warnings=$((warnings + 1)); }
fail() { printf 'FAIL  %s\n' "$*"; failures=$((failures + 1)); }

if [[ "$(uname -m)" == "x86_64" ]]; then
  pass "Intel/x86_64 Mac"
else
  fail "Unsupported architecture: $(uname -m)"
fi

macos_version="$(sw_vers -productVersion 2>/dev/null || echo unknown)"
if [[ "$macos_version" == 13.* ]]; then
  pass "macOS Ventura $macos_version"
else
  fail "Unsupported macOS version: $macos_version"
fi

if xcode-select -p >/dev/null 2>&1 && command -v clang >/dev/null 2>&1; then
  pass "Xcode Command Line Tools / clang"
else
  fail "Xcode Command Line Tools or clang missing; run ./scripts/install"
fi

if [[ -x "$NODE_BIN/node" && -x "$NODE_BIN/npm" ]]; then
  pass "Pinned Node runtime $($NODE_BIN/node --version 2>/dev/null)"
else
  fail "Pinned Node runtime missing; run ./scripts/install"
fi

if [[ -x "$REPO_DIR/node_modules/.bin/electron" ]]; then
  pass "Electron runtime installed"
else
  fail "Root npm dependencies are incomplete; run ./scripts/install"
fi

if [[ -d "$REPO_DIR/src/client-viewer/node_modules" ]]; then
  pass "Viewer npm dependencies installed"
else
  fail "Viewer npm dependencies are incomplete; run ./scripts/install"
fi

if [[ -f "$HOST_ENTRY" && -f "$VIEWER_ENTRY" ]]; then
  if [[ -n "$(find "$REPO_DIR/src" "$REPO_DIR/electron.vite.config.ts" "$REPO_DIR/package.json" -newer "$HOST_ENTRY" -print -quit 2>/dev/null)" ]]; then
    warn "Built host assets are older than repository sources; run ./scripts/install"
  else
    pass "Built host and viewer assets present and current"
  fi
else
  fail "Built host/viewer assets missing; run ./scripts/install"
fi

if [[ -x "$INPUT_HELPER" ]]; then
  pass "Touch input helper installed"
  if [[ -f "$INPUT_HELPER_SOURCE" && "$INPUT_HELPER_SOURCE" -nt "$INPUT_HELPER" ]]; then
    warn "Touch input helper is older than its source; run ./scripts/install before checking Accessibility"
  else
    "$INPUT_HELPER" --accessibility-check </dev/null >/dev/null 2>&1
    ax_status=$?
    if [[ $ax_status -eq 0 ]]; then
      pass "Accessibility permission trusted for touch helper"
    elif [[ $ax_status -eq 2 ]]; then
      warn "Accessibility permission not yet granted for touch helper"
    else
      warn "Could not determine Accessibility trust from touch helper"
    fi
  fi
else
  fail "Touch input helper missing; run ./scripts/install"
fi

if command -v ipad >/dev/null 2>&1; then
  pass "Global ipad command resolves to $(command -v ipad)"
else
  warn "Global ipad command is not on PATH; use ./scripts/ipad or add the installer wrapper directory to PATH"
fi

if ifconfig | grep -q "inet ${FIXED_IP} "; then
  pass "USB/private network exposes ${FIXED_IP}"
else
  warn "${FIXED_IP} is absent; connect/trust the iPad and enable Internet Sharing from Wi-Fi to iPad USB"
fi

status_output="$($REPO_DIR/scripts/ipad status 2>/dev/null || true)"
if printf '%s\n' "$status_output" | grep -Eq '^iPad mode: (display-only|touch)$'; then
  mode_line="$(printf '%s\n' "$status_output" | head -n 1)"
  pass "$mode_line"
else
  info "iPad mode: stopped"
fi

if lsof -nP -iTCP:"${FIXED_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  if printf '%s\n' "$status_output" | grep -Eq '^iPad mode: (display-only|touch)$'; then
    pass "Port ${FIXED_PORT} is in use while this stack reports an active mode"
  else
    warn "Port ${FIXED_PORT} is occupied by another or unowned process"
  fi
else
  pass "Port ${FIXED_PORT} is free"
fi

info "Screen Recording is verified by the capture host at runtime; doctor does not impersonate that TCC identity."
info "System Events/Automation for Mission Control and Spaces is intentionally not triggered by doctor."

printf '\n'
if [[ $failures -gt 0 ]]; then
  printf 'Doctor result: %d failure(s), %d warning(s).\n' "$failures" "$warnings"
  exit 1
fi
printf 'Doctor result: ready with %d warning(s).\n' "$warnings"
exit 0
