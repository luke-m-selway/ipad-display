#!/bin/bash
# iPad Display Workflow CLI
# Single command to start/stop the iPad streaming workflow

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VIRTUAL_DISPLAY_BIN="$HOME/ipad-4x3-display"
STATE_DIR="/tmp/ipad-display"
PID_FILE="$STATE_DIR/pid"
VD_PID_FILE="$STATE_DIR/vd-pid"
LOG_FILE="$STATE_DIR/ipad.log"
FIXED_ROOM_ID="ipad-main"
FIXED_PORT=3131
BIND_IP="192.168.2.1"

# Detect if running from the ipad-display repository
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

mkdir -p "$STATE_DIR"

usage() {
    echo "Usage: ipad [start|stop|status]"
    echo ""
    echo "Commands:"
    echo "  start   Start the iPad display virtual screen and streaming host"
    echo "  stop    Stop all iPad display processes"
    echo "  status  Check if iPad display is running"
    echo ""
    echo "The iPad will connect at: http://${BIND_IP}:${FIXED_PORT}/"
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $*" | tee -a "$LOG_FILE" >&2
}

stop_processes() {
    log "Stopping iPad display workflow..."
    
    # Stop Electron if running (only our process)
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            log "Stopping Electron process $PID..."
            kill "$PID" 2>/dev/null || true
            sleep 1
            # Force kill if still running
            kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi
    
    # Stop virtual display if we started it (only our PID)
    if [ -f "$VD_PID_FILE" ]; then
        VD_PID=$(cat "$VD_PID_FILE")
        if kill -0 "$VD_PID" 2>/dev/null; then
            log "Stopping virtual display process $VD_PID..."
            kill "$VD_PID" 2>/dev/null || true
            sleep 1
            kill -9 "$VD_PID" 2>/dev/null || true
        fi
        rm -f "$VD_PID_FILE"
    fi
    
    log "iPad display workflow stopped."
}

check_status() {
    local electron_running=false
    local vd_running=false
    
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Electron host is RUNNING (PID: $PID)"
            electron_running=true
        fi
    fi
    
    if [ -f "$VD_PID_FILE" ]; then
        VD_PID=$(cat "$VD_PID_FILE")
        if kill -0 "$VD_PID" 2>/dev/null; then
            echo "Virtual display is RUNNING (PID: $VD_PID)"
            vd_running=true
        fi
    fi
    
    if [ "$electron_running" = false ] && [ "$vd_running" = false ]; then
        echo "iPad display is NOT running"
        return 1
    fi
    
    echo "Connect your iPad to: http://${BIND_IP}:${FIXED_PORT}/"
    return 0
}

start_ipad_mode() {
    log "Starting iPad display workflow..."
    
    # Check if already running
    if check_status > /dev/null 2>&1; then
        log "iPad display is already running"
        check_status
        return 0
    fi
    
    # Verify virtual display binary exists
    if [ ! -x "$VIRTUAL_DISPLAY_BIN" ]; then
        error "Virtual display binary not found at $VIRTUAL_DISPLAY_BIN"
        error "Please compile it first:"
        error "  clang -o ~/ipad-4x3-display ~/ipad-4x3-display.m -framework Cocoa -framework CoreGraphics"
        return 1
    fi
    
    # Check if virtual display is already running (external instance)
    existing_vd=$(pgrep -f "^$VIRTUAL_DISPLAY_BIN" 2>/dev/null || true)
    if [ -n "$existing_vd" ]; then
        log "Virtual display already running (external): PID $existing_vd"
    else
        # Start virtual display
        log "Starting virtual display..."
        "$VIRTUAL_DISPLAY_BIN" >> "$LOG_FILE" 2>&1 &
        VD_PID=$!
        echo "$VD_PID" > "$VD_PID_FILE"
        log "Virtual display started: PID $VD_PID"
        sleep 2
        
        # Verify it started
        if ! kill -0 "$VD_PID" 2>/dev/null; then
            error "Virtual display failed to start"
            rm -f "$VD_PID_FILE"
            return 1
        fi
    fi
    
    # Build the app (only if needed)
    log "Building app..."
    cd "$REPO_DIR"
    
    # Set environment for iPad mode
    export IPAD_MODE=1
    export IPAD_FIXED_ROOM_ID="$FIXED_ROOM_ID"
    export IPAD_BIND_IP="$BIND_IP"
    
    # Check if build is needed by comparing timestamps
    APP_OUT="$REPO_DIR/out/main/ipad-host.js"
    NEED_BUILD=true
    
    if [ -f "$APP_OUT" ]; then
        # Check if source files are newer than output
        src_mtime=$(find "$REPO_DIR/src/ipad-host" "$REPO_DIR/src/server" -name "*.ts" -newer "$APP_OUT" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$src_mtime" = "0" ]; then
            NEED_BUILD=false
            log "Build output is up-to-date, skipping rebuild"
        fi
    fi
    
    if [ "$NEED_BUILD" = true ]; then
        log "Building client viewer..."
        if ! npm run buildClientViewer >> "$LOG_FILE" 2>&1; then
            error "Failed to build client viewer"
            return 1
        fi
        
        log "Building main app..."
        if ! npx electron-vite build >> "$LOG_FILE" 2>&1; then
            error "Failed to build app"
            return 1
        fi
    fi
    
    # Find the electron binary - try system first, then local
    if [ -x "/Applications/Deskreen CE.app/Contents/MacOS/Electron" ]; then
        ELECTRON_BIN="/Applications/Deskreen CE.app/Contents/MacOS/Electron"
    elif [ -x "$REPO_DIR/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" ]; then
        ELECTRON_BIN="$REPO_DIR/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
    elif [ -x "$REPO_DIR/node_modules/.bin/electron" ]; then
        ELECTRON_BIN="$REPO_DIR/node_modules/.bin/electron"
    else
        error "Electron binary not found"
        return 1
    fi
    
    log "Using Electron: $ELECTRON_BIN"
    
    # Start the app with iPad mode environment
    log "Starting Electron in iPad mode..."
    IPAD_MODE=1 IPAD_FIXED_ROOM_ID="$FIXED_ROOM_ID" IPAD_BIND_IP="$BIND_IP" \
        "$ELECTRON_BIN" "$REPO_DIR/out/main/ipad-host.js" >> "$LOG_FILE" 2>&1 &
    ELECTRON_PID=$!
    
    # Save PID
    echo "$ELECTRON_PID" > "$PID_FILE"
    
    log "iPad display workflow started"
    log "  - Virtual display PID: $(cat "$VD_PID_FILE" 2>/dev/null || echo 'external')"
    log "  - Electron PID: $ELECTRON_PID"
    log "  - Connect iPad at: http://${BIND_IP}:${FIXED_PORT}/"
    
    # Wait for server to be ready
    log "Waiting for server to be ready..."
    for i in $(seq 1 10); do
        if curl -s --connect-timeout 1 "http://${BIND_IP}:${FIXED_PORT}/" > /dev/null 2>&1; then
            log "Server is ready"
            return 0
        fi
        sleep 1
    done
    
    error "Server did not become ready within 10 seconds"
    error "Check $LOG_FILE for details"
    return 1
}

# Main command handling
case "${1:-start}" in
    start)
        start_ipad_mode
        ;;
    stop)
        stop_processes
        ;;
    status)
        check_status
        ;;
    *)
        usage
        exit 1
        ;;
esac
